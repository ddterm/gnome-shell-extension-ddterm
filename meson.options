option(
  'shebang_override',
  type : 'string',
  value : '',
  description : 'If not empty, use the specified command instead of GJS executable'
)

option(
  'tests',
  type : 'feature',
  value: 'auto',
  description : 'Run pytest during "meson test"/"ninja test"'
)

option(
  'tests_x11',
  type : 'feature',
  value: 'auto',
  description : 'Run X11 tests during "meson test"/"ninja test"'
)

option(
  'tests_wl_clipboard',
  type : 'feature',
  value: 'auto',
  description : 'Run wl-clipboard tests during "meson test"/"ninja test"'
)

option(
  'pict',
  type : 'feature',
  value: 'disabled',
  description : '''Build PICT to update pairwise test case data (requires CMake and a C++ compiler).
  You need this only if you edit tests/pict/*.model files'''
)
